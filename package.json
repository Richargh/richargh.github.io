{
  "name": "richargh-de-mastro-migration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 bootstrap for migrating the blog to Mastro.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run generate && node --experimental-strip-types server.ts",
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "validate:generated": "html-validate 'generated/**/*.html'",
    "lint": "npm run lint:tsc && oxlint --deny-warnings",
    "lint:tsc": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "devDependencies": {
    "@mastrojs/mastro": "npm:@jsr/mastrojs__mastro@0.8.10",
    "@playwright/test": "1.63.0",
    "@std/yaml": "npm:@jsr/std__yaml@1.1.1",
    "@types/node": "24.10.1",
    "asciidoctor": "3.0.4",
    "html-validate": "10.4.0",
    "oxlint": "1.87.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@mastrojs/feed": "npm:@jsr/mastrojs__feed@0.0.1",
    "microlighter": "2.0.0"
  }
}
